# Tasa automática USD → CUP de elTOQUE (ver src/lib/tasa.ts)
# Pide tu token gratuito en la API de tasas de elTOQUE
# (tasas.eltoque.com) y ponlo aquí en local, o en Vercel en
# Settings → Environment Variables. NUNCA lo subas al repo.
ELTOQUE_API_TOKEN=

# Opcional: solo si elTOQUE cambia la dirección de la API.
# ELTOQUE_API_URL=https://tasas.eltoque.com/v1/trmi

# Base de datos PostgreSQL (ver prisma/schema.prisma).
# La usa solo la agenda ligera: guardar los horarios ocupados
# que la dueña marca en su panel. En Vercel puedes crear un
# Postgres gratis en Neon (neon.tech) y pegar aquí su cadena.
# NUNCA subas un .env real al repo.
DATABASE_URL=postgresql://usuario:clave@servidor:5432/base_de_datos

# Clave del panel privado de la dueña (/panel). Es la contraseña
# que ella escribe para entrar a marcar los horarios ocupados.
# Elige una que recuerde; si la cambias, las sesiones abiertas
# dejan de valer y tiene que entrar de nuevo.
PANEL_CLAVE=pon-aqui-la-clave-del-panel
